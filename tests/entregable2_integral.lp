func int doble(int n) {
    return n * 2;
}

void main() {
    int matriz[2][3], valor, i;
    scanf(valor);
    valor = func doble(1 + 2 * 3);
    matriz[1][2] = valor;
    i = 0;
    if (!(valor < 10) && valor >= 14) {
        println("Valor:", matriz[1][2] + 1);
    } else {
        println("No valido");
    }
    while (i < 2) {
        i = i + 1;
    }
    return -(valor + i);
}
